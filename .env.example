# ==============================================================================
# AI Medical Voice Agent - Environment Configuration
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# OpenAI API Key (Optional: system uses fallback heuristic triage engine if omitted)
OPENAI_API_KEY=

# Anthropic API Key (Optional)
ANTHROPIC_API_KEY=

# Frontend Connection URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ==============================================================================
# Email Dispatch Configuration (Choose ONE option below for live inbox delivery)
# ==============================================================================

# Option 1: Gmail (Free & Quick via Google App Password)
# GMAIL_USER="your_email@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option 2: Resend API Key (Free at https://resend.com)
# RESEND_API_KEY="re_..."
# SMTP_FROM="onboarding@resend.dev"

# Option 3: Custom SMTP Server
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_password"
